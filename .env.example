# ─────────────────────────────────────────────────────────────────────────────
# NidhiSetu environment. Copy to `.env` and change every secret before any
# non-local deployment. docker-compose.yml falls back to the dev defaults shown
# here, so `docker compose up` works without a .env file on a dev machine.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Enables the simulated "today" (demo clock). MUST be false in production.
DEMO_MODE=true
# Require an authenticator app for every role, institutions included. Leave empty for the default:
# on whenever DEMO_MODE=false (officer roles always need one).
MFA_REQUIRED_ALL_ROLES=
# Public URL of the web app (used in emails and CORS).
WEB_ORIGIN=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=nidhisetu
POSTGRES_PASSWORD=nidhisetu_dev_password
POSTGRES_DB=nidhisetu
# Host-side URL (pnpm seed, tests, prisma CLI). Inside compose the API uses host `postgres`.
DATABASE_URL=postgresql://nidhisetu:nidhisetu_dev_password@localhost:5432/nidhisetu

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Object storage ───────────────────────────────────────────────────────────
# "s3" (RustFS / any S3-compatible store; used by docker compose) or "fs" (local folder, no Docker).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/objects
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=nidhisetu-documents
S3_ACCESS_KEY=nidhisetu
S3_SECRET_KEY=nidhisetu_dev_secret
S3_FORCE_PATH_STYLE=true
# 32-byte key, base64. Documents are encrypted (AES-256-GCM) by the API before upload.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DOCUMENT_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZCE=
# Max upload size in megabytes.
DOCUMENT_MAX_MB=10
# Lifetime of signed download URLs, in seconds.
DOCUMENT_URL_TTL_SECONDS=300

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
# Secrets for signing access / refresh tokens (≥ 32 random chars each).
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=28800
# Encrypts TOTP secrets at rest (32 bytes, base64).
MFA_ENCRYPTION_KEY=ZGV2LW9ubHktbWZhLWtleS1kb250LXVzZS1wcm9kISE=
# Signs daily audit-chain anchors (≥ 32 chars). Keep it in a secret store, never in the database.
# Required when NODE_ENV=production.
AUDIT_ANCHOR_KEY=dev-only-audit-anchor-key-change-me-0123456789
# Requests per minute per IP for the general rate limiter.
RATE_LIMIT_PER_MINUTE=120

# ── Email (Mailpit in dev) ───────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="NidhiSetu <no-reply@nidhisetu.local>"
# SMS adapter: "stub" logs messages instead of sending them.
SMS_ADAPTER=stub
# Set false to keep emails in-app only (tests do this).
EMAIL_ENABLED=true

# ── Bank verification adapter ────────────────────────────────────────────────
# "desk" = manual Bank Confirmation Desk for every bank, "mock-api" = simulated API for every bank,
# "auto" = simulated API for banks marked apiEnabled in the bank master, desk for the rest.
BANK_ADAPTER=auto
MOCK_BANK_API_LATENCY_MS=800
MOCK_BANK_API_FAILURE_RATE=0.1

# ── Background jobs ──────────────────────────────────────────────────────────
# BullMQ workers (lifecycle, reminders, escalation, digests). Needs Redis.
QUEUE_ENABLED=true

# ── OCR service ──────────────────────────────────────────────────────────────
OCR_URL=http://localhost:8000
# Optional LLM-assisted extraction. Off by default; the demo runs fully offline.
LLM_EXTRACTION=false

# ── Web ──────────────────────────────────────────────────────────────────────
# URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000

# ── Data protection (DPDP) ───────────────────────────────────────────────────
# Years to retain closed (released/rejected) records before they become eligible for purge.
RETENTION_YEARS_CLOSED_RECORDS=8
