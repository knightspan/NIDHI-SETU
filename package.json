{
  "name": "nidhisetu",
  "version": "0.1.0",
  "private": true,
  "description": "NidhiSetu – verifiable security deposit / FDR lifecycle portal (SIH 2026 · PS 26265 · AICTE)",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stack:up": "node scripts/local-stack.mjs up",
    "stack:down": "node scripts/local-stack.mjs down",
    "stack:status": "node scripts/local-stack.mjs status",
    "seed": "node scripts/in-stack.mjs seed",
    "demo:reset": "node scripts/in-stack.mjs demo:reset",
    "demo:otp": "pnpm --filter @nidhisetu/api demo:otp",
    "seed:docker": "docker compose exec api node dist/scripts/cli-seed.js",
    "demo:reset:docker": "docker compose exec api node dist/scripts/cli-demo-reset.js",
    "e2e": "pnpm --filter @nidhisetu/web e2e",
    "load-test": "pnpm --filter @nidhisetu/api load-test",
    "tamper": "node scripts/in-stack.mjs tamper"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "16.14.0-beta.17",
    "@embedded-postgres/darwin-x64": "16.14.0-beta.17",
    "@embedded-postgres/linux-x64": "16.14.0-beta.17",
    "@embedded-postgres/windows-x64": "16.14.0-beta.17"
  }
}
